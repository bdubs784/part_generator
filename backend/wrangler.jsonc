{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "part-generator-api",
  "main": "index.ts",
  "compatibility_date": "2026-09-01",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "part-generator",
      // from `npx wrangler d1 create part-generator`; not a secret
      "database_id": "4343ca72-c9f7-445c-aae8-a364cfcd4a6e",
      "migrations_dir": "migrations"
    }
  ],
  "vars": {
    "SITE_URL": "https://bdubs784.github.io/part_generator/"
  }
}
